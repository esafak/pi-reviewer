{
  "name": "pi-reviewer",
  "version": "0.5.4",
  "private": true,
  "bin": {
    "pi-reviewer": "./src/ci/bin.ts"
  },
  "type": "module",
  "scripts": {
    "build": "vp run build:ui && tsc --noEmit -p tsconfig.json",
    "build:ui": "vp build --config ui/vite.config.ts",
    "dev:ui": "vp dev --config ui/vite.config.ts",
    "lint": "vp lint && tsx scripts/lint-graphql.ts",
    "test": "vitest run",
    "typecheck:types": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@microsoft/mxc-sdk": "1.0.0",
    "dompurify": "^3.4.2",
    "highlight.js": "^11.11.1",
    "pi-lsp": "0.1.7",
    "pi-mcp-adapter": "5.1.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@octokit/graphql-schema": "15.26.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.0.1",
    "marked": "^18.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^7.0.0",
    "vite": "catalog:",
    "vite-plugin-singlefile": "^2.3.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
