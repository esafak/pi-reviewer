{
  "name": "pi-reviewer",
  "version": "0.5.4",
  "private": true,
  "bin": {
    "pi-reviewer": "./dist/src/ci/bin.js"
  },
  "type": "module",
  "scripts": {
    "build": "vp run build:ui && tsc -p tsconfig.json",
    "build:ui": "vp build --config ui/vite.config.ts",
    "dev:ui": "vp dev --config ui/vite.config.ts",
    "test": "vp test --run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "dompurify": "^3.4.2",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "marked": "^18.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.20.5",
    "typescript": "^7.0.0",
    "vite": "catalog:",
    "vite-plugin-singlefile": "^2.3.0",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@11.22.0",
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
