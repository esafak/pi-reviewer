amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"

local linters = new Mapping<String, Step> {
  ["vite-plus-lint"] {
    glob = List("**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx")
    exclude = List("dist/**", "dist-ui/**")
    check = "mise run lint"
  }
  ["vite-plus-fmt"] {
    glob = List("**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx")
    exclude = List("dist/**", "dist-ui/**")
    check = "mise run fmt -- --check {{files}}"
  }
}

local prepush = new Mapping<String, Step> {
  ["test-suite"] {
    check = "mise run test"
  }
  ["vite-plus-lint"] {
    glob = List("**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx")
    exclude = List("dist/**", "dist-ui/**")
    check = "mise run lint"
  }
  ["vite-plus-fmt"] {
    glob = List("**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx")
    exclude = List("dist/**", "dist-ui/**")
    check = "mise run fmt -- --check {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    steps = linters
  }
  ["pre-push"] {
    steps = prepush
  }
}
